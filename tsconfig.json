{
  "compilerOptions": {
    "types": ["node", "emscripten"],
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": ["node_modules", "test/fixtures"]
}
